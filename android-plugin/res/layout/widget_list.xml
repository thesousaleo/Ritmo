<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:id="@+id/w_head"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp">
            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Ritmo"
                android:textColor="@color/ritmo_widget_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/w_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/ritmo_widget_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <ImageView
                android:id="@+id/w_add"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/widget_plus"
                android:contentDescription="Adicionar" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:text="Abra o Ritmo para carregar"
            android:textColor="@color/ritmo_widget_muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingTop="2dp"
            android:textColor="@color/ritmo_widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
