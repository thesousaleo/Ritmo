<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="6dp">
        <LinearLayout
            android:id="@+id/q1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="Tarefa">
            <ImageView
                android:id="@+id/q1_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/widget_plus"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/q1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tarefa"
                android:textColor="@color/ritmo_widget_muted"
                android:textSize="11.5sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="Foco">
            <ImageView
                android:id="@+id/q2_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/widget_timer"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/q2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Foco"
                android:textColor="@color/ritmo_widget_muted"
                android:textSize="11.5sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="Hábitos">
            <ImageView
                android:id="@+id/q3_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/widget_sprout"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/q3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hábitos"
                android:textColor="@color/ritmo_widget_muted"
                android:textSize="11.5sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="Agenda">
            <ImageView
                android:id="@+id/q4_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/widget_calendar"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/q4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Agenda"
                android:textColor="@color/ritmo_widget_muted"
                android:textSize="11.5sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
